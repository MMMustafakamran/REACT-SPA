# Dependencies — three scaffolds, reinstalled by the pipeline on every run.
node_modules/

# Build output.
dist/
*.tsbuildinfo

# Recordings and run artifacts. Reproducible from this repo plus
# `npm run automate`; committing them took a sibling repo's .git to 348MB
# before its history had to be rewritten. Publish as release assets instead.
autorecorder/videos/*.webm
autorecorder/videos/RUN_REPORT.*
autorecorder/videos/DOC_DRIFT.md

# Captured terminal sessions. Regenerated by capture.ts on every run, and
# specific to the machine that produced them (absolute paths in the header).
autorecorder/videos/logs/

# Secrets.
.env
.env.local
